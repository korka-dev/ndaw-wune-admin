# Variables de production du dashboard (lues par deploy_docker.sh / docker-compose.yml).
# deploy_docker.sh crée .env.production depuis ce fichier s'il n'existe pas.
# Ces valeurs sont intégrées dans le bundle AU BUILD : rebuild après modification.

# URL publique du backend FastAPI
NEXT_PUBLIC_API_URL=https://api.ndawwune.cloud/api/v1

# Domaine du dashboard (Server Actions Next.js + config Caddy)
NEXT_PUBLIC_APP_ORIGIN=admin.ndawwune.cloud
